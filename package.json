{
  "name": "@mksine/mks",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "description": "MKS admin panel for Goravel: Filament-style resources, forms, tables, actions and policies, plus the MKSine CMS (pages, posts, media, menus, page builder, themes, plugins, SEO). React 19 + TypeScript UI over a JSON protocol.",
  "keywords": [
    "goravel",
    "golang",
    "go",
    "laravel",
    "filament",
    "admin",
    "admin-panel",
    "panel",
    "dashboard",
    "crud",
    "cms",
    "react",
    "typescript",
    "rtl",
    "i18n",
    "mks",
    "mksine"
  ],
  "author": {
    "name": "Miran Salehi",
    "url": "https://github.com/MiranSalehi"
  },
  "license": "MIT",
  "homepage": "https://github.com/MiranSalehi/mks#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MiranSalehi/mks.git"
  },
  "bugs": {
    "url": "https://github.com/MiranSalehi/mks/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "styles.css",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./access": {
      "types": "./dist/plugins/access/index.d.ts",
      "import": "./dist/plugins/access/index.js"
    },
    "./activity": {
      "types": "./dist/plugins/activity/index.d.ts",
      "import": "./dist/plugins/activity/index.js"
    },
    "./appearance": {
      "types": "./dist/plugins/appearance/index.d.ts",
      "import": "./dist/plugins/appearance/index.js"
    },
    "./cms": {
      "types": "./dist/plugins/cms/index.d.ts",
      "import": "./dist/plugins/cms/index.js"
    },
    "./navigation": {
      "types": "./dist/plugins/navigation/index.d.ts",
      "import": "./dist/plugins/navigation/index.js"
    },
    "./system": {
      "types": "./dist/plugins/system/index.d.ts",
      "import": "./dist/plugins/system/index.js"
    },
    "./translations": {
      "types": "./dist/plugins/translations/index.d.ts",
      "import": "./dist/plugins/translations/index.js"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node scripts/build-styles.mjs",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:exports": "node scripts/check-exports.mjs",
    "pack:check": "pnpm pack --pack-destination /tmp/mks-packs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-list": "^3.34.0",
    "@tiptap/extension-table": "^3.34.0",
    "@tiptap/extension-text-align": "^3.34.0",
    "@tiptap/extension-text-style": "^3.34.0",
    "@tiptap/extensions": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.18",
    "marked": "^18.2.1"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "tsup": "^8.5.0"
  },
  "packageManager": "pnpm@12.21.0"
}
